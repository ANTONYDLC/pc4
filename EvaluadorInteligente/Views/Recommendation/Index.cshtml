@{
    ViewData["Title"] = "Recomendaciones";
}

<h2>Recomendaciones para el usuario @ViewBag.UserId</h2>

<form method="post">
    <label for="userId">Ingrese ID de usuario:</label>
    <input type="text" name="userId" id="userId" required />
    <button type="submit">Obtener recomendaciones</button>
</form>

@if (ViewBag.Recommendations != null)
{
    <h3>Productos recomendados:</h3>
    <ul>
        @foreach (var item in ViewBag.Recommendations)
        {
            <li>@item</li>
        }
    </ul>
}
