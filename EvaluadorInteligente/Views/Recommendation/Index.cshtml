@{
    ViewData["Title"] = "Recomendación de Producto";
}

<h2>@ViewData["Title"]</h2>

<form method="post">
    <label>Opinión:</label>
    <input type="text" name="opinion" class="form-control" />
    <button type="submit" class="btn btn-primary">Enviar</button>
</form>

@if (ViewBag.Recommendation != null)
{
    <div class="alert alert-info mt-3">
        <strong>Recomendación:</strong> @ViewBag.Recommendation
    </div>
}
